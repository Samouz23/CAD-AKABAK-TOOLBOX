// --- Horn loft (throat → mouth) ---
_hpre() = Surface{:};
_hn0 = #_hpre();
ThruSections(1) = {110601, 110602, 110603, 110604, 110605, 110606, 110607, 110608, 110609, 110610, 110611, 110612, 110613, 110614, 110615, 110616, 110617, 110618, 110619, 110620};
_hpost() = Surface{:};
_hlat = -1; _hmv = -1;
For _i In {_hn0 : #_hpost()-1}
  _bb() = BoundingBox Surface{_hpost(_i)};
  _cut = 0;
  If ((_bb(3)-_bb(0)) < 0.01860) _cut = 1; EndIf
  If ((_bb(4)-_bb(1)) < 0.01860) _cut = 1; EndIf
  If (_cut == 0)
    _v = (_bb(3)-_bb(0)) * (_bb(4)-_bb(1)) * (_bb(5)-_bb(2));
    If (_v > _hmv) _hmv = _v; _hlat = _hpost(_i); EndIf
  EndIf
EndFor
_htc = -1; _hmc = -1; _mnz = 1e30; _mxz = -1e30;
For _i In {_hn0 : #_hpost()-1}
  _s = _hpost(_i);
  _bb() = BoundingBox Surface{_s};
  _cut = 0;
  If ((_bb(3)-_bb(0)) < 0.01860) _cut = 1; EndIf
  If ((_bb(4)-_bb(1)) < 0.01860) _cut = 1; EndIf
  If (_cut == 1)
    Recursive Delete{ Surface{_s}; }
  EndIf
  If (_cut == 0)
    If (_s != _hlat)
      _zm = (_bb(2) + _bb(5)) / 2;
      If (_zm < _mnz) _mnz = _zm; _htc = _s; EndIf
      If (_zm > _mxz) _mxz = _zm; _hmc = _s; EndIf
    EndIf
  EndIf
EndFor

Curve Loop(210621) = {10541, 10561, 10562};
Plane Surface(210622) = {210621};
// --- Interface wall + face (straight extrusion) ---
_iw[] = Extrude {0, 0, 5.000000} { Curve{10560}; };
_fEnds() = Boundary{ Curve{_iw[0]}; };
Point(210651) = {0, 0, 16.000000, 0};
Line(210641) = {_fEnds(1), 210651};
Line(210642) = {210651, _fEnds(0)};
Curve Loop(210643) = {_iw[0], 210641, 210642};
Surface(210644) = {210643};

_g0() = {_hlat};
_g1() = {210622};
_g2() = {_iw[1]};
_g3() = {210644};

// --- Physical Surfaces for BEM ---
Physical Surface("horn_surface") = {_g0()};
Physical Surface("throat_cap") = {_g1()};
Physical Surface("interface_wall") = {_g2()};
Physical Surface("interface_face") = {_g3()};

// --- Mesh parameters ---
Mesh.CharacteristicLengthMax = 10;
Mesh.MeshSizeFromCurvature = 5;
Mesh.Algorithm = 6;
