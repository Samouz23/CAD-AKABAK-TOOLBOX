// --- Horn loft (throat → mouth) ---
_hpre() = Surface{:};
_hn0 = #_hpre();
ThruSections(1) = {110961, 110962, 110963, 110964, 110965, 110966, 110967, 110968, 110969, 110970, 110971, 110972, 110973, 110974, 110975, 110976, 110977, 110978, 110979, 110980, 110981, 110982, 110983, 110984, 110985, 110986, 110987, 110988, 110989, 110990};
_hpost() = Surface{:};
_hlat = -1; _hmv = -1;
For _i In {_hn0 : #_hpost()-1}
  _bb() = BoundingBox Surface{_hpost(_i)};
  _cut = 0;
  If ((_bb(3)-_bb(0)) < 0.01860) _cut = 1; EndIf
  If ((_bb(4)-_bb(1)) < 0.01860) _cut = 1; EndIf
  If (_cut == 0)
    _v = (_bb(3)-_bb(0)) * (_bb(4)-_bb(1)) * (_bb(5)-_bb(2));
    If (_v > _hmv) _hmv = _v; _hlat = _hpost(_i); EndIf
  EndIf
EndFor
_htc = -1; _hmc = -1; _mnz = 1e30; _mxz = -1e30;
For _i In {_hn0 : #_hpost()-1}
  _s = _hpost(_i);
  _bb() = BoundingBox Surface{_s};
  _cut = 0;
  If ((_bb(3)-_bb(0)) < 0.01860) _cut = 1; EndIf
  If ((_bb(4)-_bb(1)) < 0.01860) _cut = 1; EndIf
  If (_cut == 1)
    Recursive Delete{ Surface{_s}; }
  EndIf
  If (_cut == 0)
    If (_s != _hlat)
      _zm = (_bb(2) + _bb(5)) / 2;
      If (_zm < _mnz) _mnz = _zm; _htc = _s; EndIf
      If (_zm > _mxz) _mxz = _zm; _hmc = _s; EndIf
    EndIf
  EndIf
EndFor

// --- Interface wall loft (mouth → interface plane) ---
_wpre() = Surface{:};
_wn0 = #_wpre();
ThruSections(1001) = {110991, 110992, 110993};
_wpost() = Surface{:};
_wlat = -1; _wmv = -1;
For _i In {_wn0 : #_wpost()-1}
  _bb() = BoundingBox Surface{_wpost(_i)};
  _cut = 0;
  If ((_bb(3)-_bb(0)) < 0.01860) _cut = 1; EndIf
  If ((_bb(4)-_bb(1)) < 0.01860) _cut = 1; EndIf
  If (_cut == 0)
    _v = (_bb(3)-_bb(0)) * (_bb(4)-_bb(1)) * (_bb(5)-_bb(2));
    If (_v > _wmv) _wmv = _v; _wlat = _wpost(_i); EndIf
  EndIf
EndFor
_wtc = -1; _wmc = -1; _mnz = 1e30; _mxz = -1e30;
For _i In {_wn0 : #_wpost()-1}
  _s = _wpost(_i);
  _bb() = BoundingBox Surface{_s};
  _cut = 0;
  If ((_bb(3)-_bb(0)) < 0.01860) _cut = 1; EndIf
  If ((_bb(4)-_bb(1)) < 0.01860) _cut = 1; EndIf
  If (_cut == 1)
    Recursive Delete{ Surface{_s}; }
  EndIf
  If (_cut == 0)
    If (_s != _wlat)
      _zm = (_bb(2) + _bb(5)) / 2;
      If (_zm < _mnz) _mnz = _zm; _wtc = _s; EndIf
      If (_zm > _mxz) _mxz = _zm; _wmc = _s; EndIf
    EndIf
  EndIf
EndFor

