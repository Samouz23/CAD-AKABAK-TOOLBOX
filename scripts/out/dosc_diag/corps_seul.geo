  _htag = Abs(_hbnd(_hi));
  _hbb() = BoundingBox Surface{_htag};
  If ((_hbb(5) - _hbb(2)) < 1e-3)
    Recursive Delete{ Surface{_htag}; }
  Else
    _hkept() += _htag;
  EndIf
EndFor

// =================== Corps interne (diffuseur) ===================
ThruSections(2) = {2000002, 2000003, 2000004, 2000005, 2000006, 2000007, 2000008, 2000009, 2000010, 2000011, 2000012, 2000013, 2000014, 2000015, 2000016, 2000017, 2000018, 2000019, 2000020, 2000021, 2000022, 2000023, 2000024, 2000025, 2000026, 2000027, 2000028, 2000029};
_bbnd() = Boundary{ Volume{2}; };
Delete{ Volume{2}; }
_bkept() = {};
For _bi In {0 : #_bbnd()-1}
  _btag = Abs(_bbnd(_bi));
  _bbb() = BoundingBox Surface{_btag};
  If ((_bbb(5) - _bbb(2)) < 1e-3)
    Recursive Delete{ Surface{_btag}; }
  Else
    _bkept() += _btag;
  EndIf
EndFor

// --- Body nose flat + trailing-edge flat ---
Curve Loop(3000030) = {1000002};
Plane Surface(3000031) = {3000030};
Curve Loop(3000032) = {1000029};
Plane Surface(3000033) = {3000032};

// --- Throat cap (source) ---
Curve Loop(3000034) = {1000000};
Plane Surface(3000035) = {3000034};

// --- Interface wall + radiating face ---
_iw[] = Extrude {0, 0, 30.000000} { Curve{1000001}; };
Curve Loop(3000036) = {_iw[0]};
Surface(3000037) = {3000036};

// --- Physical Surfaces for BEM ---
Physical Surface("horn_surface") = {_hkept(), _bkept(), 3000031, 3000033, _iw[1]};
Physical Surface("throat_cap") = {3000035};
Physical Surface("interface_face") = {3000037};

// --- Mesh parameters ---
Mesh.CharacteristicLengthMax = 10;
Mesh.MeshSizeFromCurvature = 5;
Mesh.Algorithm = 6;
