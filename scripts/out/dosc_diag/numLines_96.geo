Plane Surface(3000060) = {3000059};

// --- Throat cap (source) ---
Curve Loop(3000061) = {1000000};
Plane Surface(3000062) = {3000061};

// --- Interface wall + radiating face ---
_iw[] = Extrude {0, 0, 30.000000} { Curve{1000028}; };
Curve Loop(3000063) = {_iw[0]};
Surface(3000064) = {3000063};

// --- Physical Surfaces for BEM ---
Physical Surface("horn_surface") = {_hkept(), _bkept(), 3000058, 3000060, _iw[1]};
Physical Surface("throat_cap") = {3000062};
Physical Surface("interface_face") = {3000064};

