// --- Horn loft (throat → mouth) ---
_hpre() = Surface{:};
_hn0 = #_hpre();
ThruSections(1) = {113091, 113092, 113093, 113094, 113095, 113096, 113097, 113098, 113099, 113100, 113101, 113102, 113103, 113104, 113105, 113106, 113107, 113108, 113109, 113110, 113111, 113112, 113113, 113114, 113115, 113116, 113117, 113118, 113119, 113120, 113121, 113122, 113123, 113124, 113125, 113126, 113127, 113128, 113129, 113130, 113131, 113132, 113133, 113134, 113135, 113136, 113137, 113138, 113139, 113140, 113141, 113142, 113143, 113144, 113145, 113146, 113147, 113148, 113149, 113150, 113151, 113152, 113153, 113154, 113155, 113156, 113157, 113158, 113159, 113160, 113161, 113162, 113163, 113164, 113165, 113166, 113167, 113168, 113169, 113170, 113171, 113172, 113173, 113174, 113175, 113176, 113177, 113178, 113179, 113180, 113181, 113182, 113183, 113184, 113185, 113186, 113187, 113188, 113189, 113190, 113191};
_hpost() = Surface{:};
_hlat = -1; _hmv = -1;
For _i In {_hn0 : #_hpost()-1}
  _bb() = BoundingBox Surface{_hpost(_i)};
  _cut = 0;
  If ((_bb(3)-_bb(0)) < 0.01200) _cut = 1; EndIf
  If ((_bb(4)-_bb(1)) < 0.01200) _cut = 1; EndIf
  If (_cut == 0)
    _v = (_bb(3)-_bb(0)) * (_bb(4)-_bb(1)) * (_bb(5)-_bb(2));
    If (_v > _hmv) _hmv = _v; _hlat = _hpost(_i); EndIf
  EndIf
EndFor
_htc = -1; _hmc = -1; _mnz = 1e30; _mxz = -1e30;
For _i In {_hn0 : #_hpost()-1}
  _s = _hpost(_i);
  _bb() = BoundingBox Surface{_s};
  _cut = 0;
  If ((_bb(3)-_bb(0)) < 0.01200) _cut = 1; EndIf
  If ((_bb(4)-_bb(1)) < 0.01200) _cut = 1; EndIf
  If (_cut == 1)
    Recursive Delete{ Surface{_s}; }
  EndIf
  If (_cut == 0)
    If (_s != _hlat)
      _zm = (_bb(2) + _bb(5)) / 2;
      If (_zm < _mnz) _mnz = _zm; _htc = _s; EndIf
      If (_zm > _mxz) _mxz = _zm; _hmc = _s; EndIf
    EndIf
  EndIf
EndFor

// --- Interface wall loft (mouth → interface plane) ---
_wpre() = Surface{:};
_wn0 = #_wpre();
ThruSections(1001) = {113192, 113193, 113194};
_wpost() = Surface{:};
_wlat = -1; _wmv = -1;
For _i In {_wn0 : #_wpost()-1}
  _bb() = BoundingBox Surface{_wpost(_i)};
  _cut = 0;
  If ((_bb(3)-_bb(0)) < 0.01200) _cut = 1; EndIf
  If ((_bb(4)-_bb(1)) < 0.01200) _cut = 1; EndIf
  If (_cut == 0)
    _v = (_bb(3)-_bb(0)) * (_bb(4)-_bb(1)) * (_bb(5)-_bb(2));
    If (_v > _wmv) _wmv = _v; _wlat = _wpost(_i); EndIf
  EndIf
EndFor
_wtc = -1; _wmc = -1; _mnz = 1e30; _mxz = -1e30;
For _i In {_wn0 : #_wpost()-1}
  _s = _wpost(_i);
  _bb() = BoundingBox Surface{_s};
  _cut = 0;
  If ((_bb(3)-_bb(0)) < 0.01200) _cut = 1; EndIf
  If ((_bb(4)-_bb(1)) < 0.01200) _cut = 1; EndIf
  If (_cut == 1)
    Recursive Delete{ Surface{_s}; }
  EndIf
  If (_cut == 0)
    If (_s != _wlat)
      _zm = (_bb(2) + _bb(5)) / 2;
      If (_zm < _mnz) _mnz = _zm; _wtc = _s; EndIf
      If (_zm > _mxz) _mxz = _zm; _wmc = _s; EndIf
    EndIf
  EndIf
EndFor

