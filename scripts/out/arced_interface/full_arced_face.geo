// --- Horn loft (throat → mouth) ---
_hpre() = Surface{:};
_hn0 = #_hpre();
ThruSections(1) = {113637, 113638, 113639, 113640, 113641, 113642, 113643, 113644, 113645, 113646, 113647, 113648, 113649, 113650, 113651, 113652, 113653, 113654, 113655, 113656, 113657, 113658, 113659, 113660, 113661, 113662, 113663, 113664, 113665, 113666, 113667};
_hpost() = Surface{:};
_hlat = -1; _hmv = -1;
For _i In {_hn0 : #_hpost()-1}
  _bb() = BoundingBox Surface{_hpost(_i)};
  _cut = 0;
  If (_cut == 0)
    _v = (_bb(3)-_bb(0)) * (_bb(4)-_bb(1)) * (_bb(5)-_bb(2));
    If (_v > _hmv) _hmv = _v; _hlat = _hpost(_i); EndIf
  EndIf
EndFor
_htc = -1; _hmc = -1; _mnz = 1e30; _mxz = -1e30;
For _i In {_hn0 : #_hpost()-1}
  _s = _hpost(_i);
  _bb() = BoundingBox Surface{_s};
  _cut = 0;
  If (_cut == 1)
    Recursive Delete{ Surface{_s}; }
  EndIf
  If (_cut == 0)
    If (_s != _hlat)
      _zm = (_bb(2) + _bb(5)) / 2;
      If (_zm < _mnz) _mnz = _zm; _htc = _s; EndIf
      If (_zm > _mxz) _mxz = _zm; _hmc = _s; EndIf
    EndIf
  EndIf
EndFor

