// --- Horn loft (throat → mouth) ---
_hpre() = Surface{:};
_hn0 = #_hpre();
ThruSections(1) = {115354, 115355, 115356, 115357, 115358, 115359, 115360, 115361, 115362, 115363, 115364, 115365, 115366, 115367, 115368, 115369, 115370, 115371, 115372, 115373, 115374, 115375, 115376, 115377, 115378, 115379, 115380, 115381, 115382, 115383, 115384, 115385, 115386, 115387, 115388, 115389, 115390, 115391, 115392, 115393, 115394, 115395, 115396, 115397, 115398, 115399, 115400, 115401, 115402, 115403, 115404, 115405, 115406, 115407, 115408, 115409, 115410, 115411, 115412, 115413, 115414, 115415, 115416, 115417, 115418, 115419, 115420, 115421, 115422, 115423, 115424, 115425, 115426, 115427, 115428, 115429, 115430, 115431, 115432, 115433, 115434, 115435, 115436, 115437, 115438, 115439, 115440, 115441, 115442, 115443, 115444, 115445, 115446, 115447, 115448, 115449, 115450, 115451, 115452, 115453, 115454};
_hpost() = Surface{:};
_hlat = -1; _hmv = -1;
For _i In {_hn0 : #_hpost()-1}
  _bb() = BoundingBox Surface{_hpost(_i)};
  _cut = 0;
  If ((_bb(4)-_bb(1)) < 0.01260) _cut = 1; EndIf
  If (_cut == 0)
    _v = (_bb(3)-_bb(0)) * (_bb(4)-_bb(1)) * (_bb(5)-_bb(2));
    If (_v > _hmv) _hmv = _v; _hlat = _hpost(_i); EndIf
  EndIf
EndFor
_htc = -1; _hmc = -1; _mnz = 1e30; _mxz = -1e30;
For _i In {_hn0 : #_hpost()-1}
  _s = _hpost(_i);
  _bb() = BoundingBox Surface{_s};
  _cut = 0;
  If ((_bb(4)-_bb(1)) < 0.01260) _cut = 1; EndIf
  If (_cut == 1)
    Recursive Delete{ Surface{_s}; }
  EndIf
  If (_cut == 0)
    If (_s != _hlat)
      _zm = (_bb(2) + _bb(5)) / 2;
      If (_zm < _mnz) _mnz = _zm; _htc = _s; EndIf
      If (_zm > _mxz) _mxz = _zm; _hmc = _s; EndIf
    EndIf
  EndIf
EndFor

Curve Loop(215455) = {15152, 15253};
Plane Surface(215456) = {215455};
// --- Interface wall + face (straight extrusion) ---
_iw[] = Extrude {0, 0, 20.000000} { Curve{15252}; };
_fEnds() = Boundary{ Curve{_iw[0]}; };
Line(215475) = {_fEnds(1), _fEnds(0)};
Curve Loop(215477) = {_iw[0], 215475};
Surface(215478) = {215477};

_g0() = {_hlat};
_g1() = {215456};
_g2() = {_iw[1]};
_g3() = {215478};

// --- Physical Surfaces for BEM ---
Physical Surface("horn_surface") = {_g0()};
Physical Surface("throat_cap") = {_g1()};
Physical Surface("interface_wall") = {_g2()};
Physical Surface("interface_face") = {_g3()};

// --- Mesh parameters ---
Mesh.CharacteristicLengthMax = 8;
Mesh.MeshSizeFromCurvature = 0;
MeshSize{ PointsOf{ Surface{_g0()}; } } = 8;
MeshSize{ PointsOf{ Surface{_g1()}; } } = 4;
MeshSize{ PointsOf{ Surface{_g2()}; } } = 8;
MeshSize{ PointsOf{ Surface{_g3()}; } } = 8;
Mesh.MeshSizeFromCurvature = 12;
