Circle(10097) = {0, 0, -100.000000, 15.000000};
Circle(10098) = {0, 0, 6.000000, 60.000000};
Circle(10099) = {0, 0, 16.000000, 60.000000};
Circle(10100) = {0, 0, 26.000000, 60.000000};

Wire(110101) = {10097};
Wire(110102) = {10098};
Wire(110103) = {10099};
Wire(110104) = {10100};

// --- Horn loft ---
ThruSections(1) = {110101, 110102, 110103, 110104};
_bnd() = Boundary{ Volume{1}; };
Delete{ Volume{1}; }
_hornIdx = 0; _maxdz = -1;
For _i In {0 : #_bnd()-1}
  _bb() = BoundingBox Surface{Abs(_bnd(_i))};
  _dz = _bb(5) - _bb(2);
  If (_dz > _maxdz) _maxdz = _dz; _hornIdx = _i; EndIf
EndFor
_throatIdx = -1; _mouthIdx = -1; _minZ = 1e30; _maxZ = -1e30;
For _i In {0 : #_bnd()-1}
  If (_i != _hornIdx)
    _bb() = BoundingBox Surface{Abs(_bnd(_i))};
    _zmid = (_bb(5) + _bb(2)) / 2;
    If (_zmid < _minZ) _minZ = _zmid; _throatIdx = _i; EndIf
    If (_zmid > _maxZ) _maxZ = _zmid; _mouthIdx = _i; EndIf
  EndIf
EndFor

// --- Physical Surfaces for BEM ---
Physical Surface("horn_surface") = {Abs(_bnd(_hornIdx))};
Physical Surface("throat_cap") = {Abs(_bnd(_throatIdx))};
Physical Surface("interface_face") = {Abs(_bnd(_mouthIdx))};

// --- Mesh parameters ---
Mesh.CharacteristicLengthMax = 8;
Mesh.MeshSizeFromCurvature = 0;
Mesh.Algorithm = 6;
