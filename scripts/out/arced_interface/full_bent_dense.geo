// --- Horn loft (throat → mouth) ---
_hpre() = Surface{:};
_hn0 = #_hpre();
ThruSections(1) = {120404, 120405, 120406, 120407, 120408, 120409, 120410, 120411, 120412, 120413, 120414, 120415, 120416, 120417, 120418, 120419, 120420, 120421, 120422, 120423, 120424, 120425, 120426, 120427, 120428, 120429, 120430, 120431, 120432, 120433, 120434, 120435, 120436, 120437, 120438, 120439, 120440, 120441, 120442, 120443, 120444, 120445, 120446, 120447, 120448, 120449, 120450, 120451, 120452, 120453, 120454, 120455, 120456, 120457, 120458, 120459, 120460, 120461, 120462, 120463, 120464, 120465, 120466, 120467, 120468, 120469, 120470, 120471, 120472, 120473, 120474, 120475, 120476, 120477, 120478, 120479, 120480, 120481, 120482, 120483, 120484, 120485, 120486, 120487, 120488, 120489, 120490, 120491, 120492, 120493, 120494, 120495, 120496, 120497, 120498, 120499, 120500, 120501, 120502, 120503, 120504};
_hpost() = Surface{:};
_hlat = -1; _hmv = -1;
For _i In {_hn0 : #_hpost()-1}
  _bb() = BoundingBox Surface{_hpost(_i)};
  _cut = 0;
  If (_cut == 0)
    _v = (_bb(3)-_bb(0)) * (_bb(4)-_bb(1)) * (_bb(5)-_bb(2));
    If (_v > _hmv) _hmv = _v; _hlat = _hpost(_i); EndIf
  EndIf
EndFor
_htc = -1; _hmc = -1; _mnz = 1e30; _mxz = -1e30;
For _i In {_hn0 : #_hpost()-1}
  _s = _hpost(_i);
  _bb() = BoundingBox Surface{_s};
  _cut = 0;
  If (_cut == 1)
    Recursive Delete{ Surface{_s}; }
  EndIf
  If (_cut == 0)
    If (_s != _hlat)
      _zm = (_bb(2) + _bb(5)) / 2;
      If (_zm < _mnz) _mnz = _zm; _htc = _s; EndIf
      If (_zm > _mxz) _mxz = _zm; _hmc = _s; EndIf
    EndIf
  EndIf
EndFor

// --- Interface wall loft (mouth → interface plane) ---
_wpre() = Surface{:};
_wn0 = #_wpre();
ThruSections(1001) = {120505, 120506, 120507};
_wpost() = Surface{:};
_wlat = -1; _wmv = -1;
For _i In {_wn0 : #_wpost()-1}
  _bb() = BoundingBox Surface{_wpost(_i)};
  _cut = 0;
  If (_cut == 0)
    _v = (_bb(3)-_bb(0)) * (_bb(4)-_bb(1)) * (_bb(5)-_bb(2));
    If (_v > _wmv) _wmv = _v; _wlat = _wpost(_i); EndIf
  EndIf
EndFor
_wtc = -1; _wmc = -1; _mnz = 1e30; _mxz = -1e30;
For _i In {_wn0 : #_wpost()-1}
  _s = _wpost(_i);
  _bb() = BoundingBox Surface{_s};
  _cut = 0;
  If (_cut == 1)
    Recursive Delete{ Surface{_s}; }
  EndIf
  If (_cut == 0)
    If (_s != _wlat)
      _zm = (_bb(2) + _bb(5)) / 2;
      If (_zm < _mnz) _mnz = _zm; _wtc = _s; EndIf
      If (_zm > _mxz) _mxz = _zm; _wmc = _s; EndIf
    EndIf
  EndIf
EndFor

Curve Loop(220508) = {20301};
Plane Surface(220509) = {220508};
Curve Loop(220512) = {20403};
Plane Surface(220513) = {220512};

_g0() = {_hlat};
_g1() = {220509};
_g2() = {_wlat};
_g3() = {220513};

// --- Physical Surfaces for BEM ---
Physical Surface("horn_surface") = {_g0()};
Physical Surface("throat_cap") = {_g1()};
Physical Surface("interface_wall") = {_g2()};
Physical Surface("interface_face") = {_g3()};

// --- Mesh parameters ---
Mesh.CharacteristicLengthMax = 8;
Mesh.MeshSizeFromCurvature = 0;
MeshSize{ PointsOf{ Surface{_g0()}; } } = 8;
MeshSize{ PointsOf{ Surface{_g1()}; } } = 4;
MeshSize{ PointsOf{ Surface{_g2()}; } } = 8;
MeshSize{ PointsOf{ Surface{_g3()}; } } = 8;
Mesh.MeshSizeFromCurvature = 12;
